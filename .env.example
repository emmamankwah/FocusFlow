# Copy this file to .env for local development.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret

# Local development database credentials (change before exposing services).
POSTGRES_DB=focusflow
POSTGRES_USER=focusflow
POSTGRES_PASSWORD=focusflow_dev

# Optional integrations. Authentication email and AI chat need these values.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=465

