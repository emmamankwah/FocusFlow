# Gmail SMTP — create an App Password for your Google account:
# Google Account -> Security -> 2-Step Verification (must be ON) -> App passwords
# https://myaccount.google.com/apppasswords

# Set the environment variables for the application
APP_NAME=FocusFlow AI
MAIL_FROM_NAME=FocusFlow AI

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_USER=
GMAIL_APP_PASSWORD=

OTP_EXPIRE_MINUTES=3


DB_HOST=localhost
DB_NAME=postgres
DB_USER=focusflow
DB_PASSWORD=password