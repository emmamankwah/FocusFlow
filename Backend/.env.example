# Copy to .env and replace local credentials before starting the backend.
# Generate JWT_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret

DB_HOST=localhost
DB_PORT=5432
DB_NAME=focusflow
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
DB_SSLMODE=prefer

# The API starts local Redis during startup when this is enabled.
LOCAL_START_REDIS=true
REDIS_URL=redis://localhost:6379/0

OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_SEND_COOLDOWN_SECONDS=45

SMTP_HOST=
SMTP_PORT=465
SMTP_TIMEOUT_SECONDS=15
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=FocusFlow

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
