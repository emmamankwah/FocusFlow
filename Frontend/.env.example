# Origin of the FastAPI backend.
#
# Leave this empty during development: requests are then sent to the Vite
# origin and proxied to http://127.0.0.1:8000 by vite.config.js.
#
# Set it to the deployed API origin for production builds, e.g.
# VITE_API_BASE_URL=https://api.focusflow.app
VITE_API_BASE_URL=
